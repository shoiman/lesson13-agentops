# Скопіювати у .env і заповнити. .env НЕ комітиться.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Ціни моделі, $ за 1M токенів (перевір актуальні на ai.google.dev/pricing)
PRICE_INPUT_PER_1M=0.25
PRICE_OUTPUT_PER_1M=1.50

# Arize Phoenix (локально в Docker)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=telco-retention-agent

# Slack Incoming Webhook (опційно; без нього алерти друкуються в консоль)
SLACK_WEBHOOK_URL=
